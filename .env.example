# Copy to .env and fill in. Never commit the real file.

# PostgreSQL (Prisma and the LangGraph checkpointer)
DATABASE_URL="postgresql://user:password@localhost:5432/peopledesk?schema=public"

# Signs the session cookie; at least 32 random characters
# (e.g. `openssl rand -base64 48`)
SESSION_SECRET=""

# Gemini: chat, reranking, the document check and embeddings
GEMINI_API_KEY=""

# Pinecone index for document chunks (3072 dimensions, cosine)
PINECONE_API_KEY=""
PINECONE_INDEX=""

# Optional: trace every LangChain/LangGraph run in LangSmith
# LANGSMITH_TRACING="true"
# LANGSMITH_API_KEY=""
# LANGSMITH_PROJECT="peopledesk-ai"

# Optional: tests (.env.test). The database name must end in _test.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/peopledesk_test?schema=public"
