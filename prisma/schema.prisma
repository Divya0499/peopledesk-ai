// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// An uploaded PDF. `id` matches the documentId stored on its Pinecone chunks.
model Document {
  id         String   @id @default(uuid())
  fileName   String
  chunkCount Int
  createdAt  DateTime @default(now())
}

model Conversation {
  id        String    @id @default(uuid())
  title     String?
  createdAt DateTime  @default(now())
  messages  Message[]
}

enum Role {
  user
  ai
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           Role
  text           String
  // The retrieved chunks an AI answer was based on; null for user messages
  sources        Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// Demo data for the function-calling exercise; read by the getLeaveBalance tool.
model Employee {
  id                String             @id
  name              String
  leaveBalance      Int
  department        String
  leaveApplications LeaveApplication[]
}

enum LeaveStatus {
  approved
  rejected
}

// One row per applyLeave request. The unique requestId lets a retried request
// be recognised so its days are not deducted twice.
model LeaveApplication {
  id        String      @id @default(uuid())
  userId    String
  employee  Employee    @relation(fields: [userId], references: [id], onDelete: Cascade)
  days      Int
  requestId String      @unique
  status    LeaveStatus
  createdAt DateTime    @default(now())

  @@index([userId])
}

// Long-term facts about a user (e.g. response_style → "short answers").
// One row per (userId, key), so saving an existing key updates it in place.
model UserMemory {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}
