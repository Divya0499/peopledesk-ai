// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// id = documentId in pinecone metadata
model Document {
  id           String         @id @default(uuid())
  fileName     String
  chunkCount   Int            @default(0)
  status       DocumentStatus @default(processing)
  error        String?
  uploadedById String?
  uploadedBy   Employee?      @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([fileName])
}

enum DocumentStatus {
  processing
  ready
  rejected
  failed
}

model Conversation {
  id           String        @id @default(uuid())
  userId       String
  user         Employee      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String?
  createdAt    DateTime      @default(now())
  messages     Message[]
  agentThreads AgentThread[]

  @@index([userId])
}

enum Role {
  user
  ai
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           Role
  text           String
  sources        Json?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Employee {
  id                String             @id @default(uuid())
  name              String
  // stored lowercase
  email             String             @unique
  // null = can't log in
  passwordHash      String?
  // pending requests are already subtracted
  leaveBalance      Int
  department        String
  role              UserRole           @default(employee)
  // null = admins approve
  managerId         String?
  manager           Employee?          @relation("ManagerReports", fields: [managerId], references: [id], onDelete: SetNull)
  reports           Employee[]         @relation("ManagerReports")
  leaveApplications LeaveApplication[] @relation("LeaveApplicant")
  leaveDecisions    LeaveApplication[] @relation("LeaveDecider")
  agentThreads      AgentThread[]
  conversations     Conversation[]
  documents         Document[]

  @@index([managerId])
}

enum UserRole {
  employee
  admin
}

enum LeaveStatus {
  pending
  approved
  rejected
  cancelled
}

model LeaveApplication {
  id           String      @id @default(uuid())
  userId       String
  employee     Employee    @relation("LeaveApplicant", fields: [userId], references: [id], onDelete: Cascade)
  days         Int
  reason       String?
  requestId    String      @unique
  status       LeaveStatus @default(pending)
  decidedById  String?
  decidedBy    Employee?   @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([status])
}

// long-term memory, e.g. response_style -> "short answers"
model UserMemory {
  id        String   @id @default(uuid())
  userId    String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

// owner of a paused langgraph run, checked before resuming
model AgentThread {
  id             String        @id
  userId         String
  employee       Employee      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // null for /api/langgraph-test runs
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@index([userId])
  @@index([conversationId])
}
